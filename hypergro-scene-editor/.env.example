# Copy to .env (loaded by the server, the worker and the scripts on start).
# Pick ONE provider. Without either, the editor still works: roles come from heuristics and chat uses the offline parser.

# --- Option A: first-party Claude API
# ANTHROPIC_API_KEY=sk-ant-...

# --- Option B: Google Cloud Vertex AI (Claude models enabled in Model Garden; the service account needs roles/aiplatform.user)
# CLAUDE_PROVIDER=vertex
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_REGION=global                          # or a regional endpoint such as us-east5 / europe-west1
# GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json   # relative to the project root; secrets/ is gitignored
#                                                # (omit to use `gcloud auth application-default login` credentials)

# --- Optional
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_FALLBACKS=1        # first-party only: server-side refusal fallbacks (beta); 0 disables
# PORT=8787
# DATA_DIR=./data

# --- Optional: keep bundle images on the CDN (local disk becomes a cache). Urls are public to anyone who has them.
# CDN_UPLOAD_URL=https://<media-upload-service>/internal/media-upload-service/v1/upload-file

# --- Optional: where problems are announced. Any incoming webhook that accepts {"text": "..."} (Slack, Google Chat, Teams).
#     Without it, problems are still written to data/errors.jsonl.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
#     A fresh server rebuilds its data from the CDN when this is set to the last root index address (see data/cdn-root.url or the log).
# CDN_ROOT_URL=https://cdn2.hypergro.ai/xxxxxxxx.json
#     Licensed legacy fonts are held back from the CDN (public address = redistribution). 1 publishes them too.
# CDN_INCLUDE_LICENSED_FONTS=0
